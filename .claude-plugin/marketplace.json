{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "hubtel",
  "owner": {
    "name": "Hubtel Enablement Team",
    "email": "engineering@hubtel.com"
  },
  "metadata": {
    "description": "Official Hubtel marketplace for AI coding agents: curated skills, MCP servers, and plugins that encode Hubtel engineering standards for building, documenting, reviewing, and shipping product code.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "hubtel-docs-as-code",
      "displayName": "Hubtel Docs As Code",
      "source": "./plugins/hubtel-docs-as-code",
      "description": "Generate, update, validate, or analyze complete DAC-compliant documentation for a Hubtel project",
      "version": "1.4.0",
      "author": {
        "name": "Hubtel Enablement Team",
        "email": "engineering@hubtel.com"
      },
      "category": "Engineering",
      "keywords": [
        "hubtel",
        "documentation",
        "dac-compliance"
      ],
      "skills": [
        "./skills/hbtl-dac-generate",
        "./skills/hbtl-dac-update",
        "./skills/hbtl-dac-validate",
        "./skills/hbtl-dac-analyze"
      ]
    },
    {
      "name": "hubtel-engineering-harness",
      "displayName": "Hubtel Engineering Harness",
      "source": "./plugins/hubtel-engineering-harness",
      "description": "Equips coding agents to run Hubtel's full engineering workflow on a repo — from feature breakdown and Azure tasks through implementation, verification, documentation, and PR lifecycle — so features ship the Hubtel way end to end.",
      "version": "2.5.1",
      "author": {
        "name": "Hubtel Enablement Team",
        "email": "engineering@hubtel.com"
      },
      "category": "Core Engineering",
      "keywords": [
        "hubtel",
        "harness",
        "engineering",
        "workflow",
        "automation"
      ],
      "skills": [
        "./skills/software-development",
        "./skills/hbtl-harness-creator"
      ],
      "mcpServers": {
        "hubtel-engineering": {
          "command": "npx",
          "args": [
            "-y",
            "@hubtel/engineering-mcp@latest"
          ]
        },
        "hubtel-sprint-planner": {
          "command": "npx",
          "args": [
            "-y",
            "@hubtel/sprint-planner-mcp@latest"
          ]
        },
        "hubtel-design-system": {
          "command": "npx",
          "args": [
            "-y",
            "@hubtel/design-system-mcp@latest"
          ]
        },
        "hubtel-sonarquabe": {
          "type": "http",
          "url": "https://sonar.hubtel.com/mcp"
        },
        "hubtel-azure-devops": {
          "type": "http",
          "url": "https://eng-mcp.hubtel.com/azure/mcp"
        },
        "chrome-devtools": {
          "command": "npx",
          "args": [
            "chrome-devtools-mcp@latest"
          ]
        }
      }
    }
  ]
}
