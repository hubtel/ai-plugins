{
  "name": "hbtl-harness-creator",
  "version": "2.8.0",
  "description": "Harness engineering for AI coding agents — five subsystems, memory persistence, session continuity, verification workflows, scope control, lifecycle management.",
  "license": "MIT",
  "author": "Learn Harness Engineering",
  "repository": "https://github.com/walkinglabs/learn-harness-engineering",
  "languages": ["en", "zh"],
  "compatibility": {
    "minCliVersion": "0.1.0",
    "agents": [
      "claude-code",
      "codex-cli",
      "cursor",
      "windsurf",
      "generic"
    ]
  },
  "entryPoint": "SKILL.md",
  "references": [
    "references/memory-persistence-pattern.md",
    "references/context-engineering-pattern.md",
    "references/skill-runtime-pattern.md",
    "references/tool-registry-pattern.md",
    "references/multi-agent-pattern.md",
    "references/lifecycle-bootstrap-pattern.md",
    "references/gotchas.md",
    "references/usage-telemetry.schema.json"
  ],
  "triggers": [
    "harness engineering",
    "agent reliability",
    "session continuity",
    "memory persistence",
    "verification workflow",
    "scope control",
    "lifecycle management",
    "AGENTS.md",
    "CLAUDE.md",
    "feature tracking",
    "session handoff",
    "multi-agent coordination",
    "context engineering",
    "tool safety",
    "permission pipeline",
    "usage telemetry"
  ],
  "bundled": {
    "scripts": [
      "scripts/create-harness.mjs",
      "scripts/install-mcps.mjs",
      "scripts/validate-harness.mjs",
      "scripts/upgrade-harness.mjs",
      "scripts/render-assessment-html.mjs",
      "scripts/run-benchmark.mjs",
      "scripts/self-test.mjs",
      "scripts/metrics.mjs",
      "scripts/append-usage-event.mjs",
      "scripts/ship-usage-telemetry.mjs",
      "scripts/lib/harness-utils.mjs",
      "scripts/lib/metrics-utils.mjs",
      "scripts/lib/azure-devops.mjs",
      "scripts/lib/usage-telemetry.mjs",
      "scripts/lib/cci-usage-api.mjs"
    ],
    "assets": [],
    "templates": [
      "templates/agents.md",
      "templates/feature-list.json",
      "templates/feature-list.schema.json",
      "templates/init.sh",
      "templates/progress.md",
      "templates/session-handoff.md",
      "templates/plan.md",
      "templates/plan.schema.json",
      "templates/overview-plan.md",
      "templates/overview-plan.schema.json"
    ]
  }
}
